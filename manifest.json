{
  "manifest_version": 3,
  "name": "SwiftSelect - Capture, Copy & Download Screenshots",
  "version": "1.6.1",
  "description": "The all-in-one tool to snap, scroll-capture, copy and download screenshots instantly.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "offscreen",
    "tabCapture",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SwiftSelect (Click to Capture)",
    "default_icon": {
      "16": "icons/icon48.png",
      "32": "icons/icon128.png"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "activate-selection": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "MacCtrl+X"
      },
      "description": "Activate selection mode"
    },
    "capture-visible-download": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+S"
      },
      "description": "Capture visible area & download"
    },
    "capture-horizontal": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "MacCtrl+H"
      },
      "description": "Capture horizontal view & download"
    },
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "MacCtrl+F"
      },
      "description": "Capture full page & download"
    },
    "capture-timer": {
      "description": "3-second delayed capture"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "src/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
