{
  "manifest_version": 3,
  "name": "SwiftSelect - Capture, Copy & Download Screenshots",
  "version": "2.0.0",
  "description": "The all-in-one tool to snap, scroll-capture, copy and download screenshots instantly.",
  "permissions": [
    "scripting",
    "activeTab",
    "tabs",
    "clipboardWrite",
    "offscreen",
    "tabCapture",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SwiftSelect",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/app16.png",
      "32": "icons/app32.png",
      "48": "icons/app48.png",
      "128": "icons/app128.png"
    }
  },
  "icons": {
    "16": "icons/app16.png",
    "32": "icons/app32.png",
    "48": "icons/app48.png",
    "128": "icons/app128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "commands": {
    "activate-selection": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "MacCtrl+X"
      },
      "description": "Activate selection mode"
    },
    "capture-visible-download": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+S"
      },
      "description": "Capture visible area & download"
    },
    "capture-horizontal": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "MacCtrl+H"
      },
      "description": "Capture horizontal view & download"
    },
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+F",
        "mac": "MacCtrl+F"
      },
      "description": "Capture full page & download"
    },
    "capture-timer": {
      "description": "Delayed capture (uses the delay from Settings, 3 seconds by default)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
